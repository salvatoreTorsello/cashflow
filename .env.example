DATABASE_URL=postgresql+psycopg://cashflow:cashflow@localhost:5432/cashflow
API_V1_STR=/api/v1
PROJECT_NAME=CashFlow

# Session cookies are marked `Secure`, so browsers only send them over HTTPS.
# Keep this `true` for any deployment reachable by other people (put a reverse
# proxy / tunnel with TLS — e.g. Caddy, Traefik, Cloudflare Tunnel — in front of
# nginx; the current docker-compose.yml serves plain http:// with no TLS of its
# own). Set to `false` only for local http://localhost dev, where login would
# otherwise silently fail because the browser refuses to store the cookie.
COOKIE_SECURE=true

# --- docker-compose stack only (ignored by the app when run outside Docker) ---
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=change-me
REGISTRY_NAMESPACE=ghcr.io/salvatoretorsello
IMAGE_TAG=latest
FRONTEND_PORT=8080
